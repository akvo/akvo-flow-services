apiVersion: v1
data:
  config.edn: |
        {
         :config-folder "/akvo-flow-server-config"
         :http-port 3000
         :stats-kinds ["User" "Device" "SurveyInstance" "Survey" "DeviceFiles"]
         :base-path "/var/tmp/akvo/flow"
         :stats-schedule-time [01 00 00]
         :log-level :info
         :dev-instances ["akvoflowsandbox.appspot.com" "watermappingmonitoring-hrd.appspot.com"
                         "flowaglimmerofhope-hrd.appspot.com" "akvoflow-uat1.appspot.com"
                         "akvoflow-dev1.appspot.com" "akvoflow-dev2.appspot.com" "wfp-161.appspot.com"
                         "flowdemoenvironment-hrd.appspot.com" "akvoflow-beta1.appspot.com"
                         "akvoflow-beta2.appspot.com"]
         ;; STARTTLS on 587 with implicit SSL off. Port 465 needs EMAIL_PORT and
         ;; EMAIL_USE_SSL set together: implicit SSL does not follow from the
         ;; port number, and without it the client opens a plaintext socket
         ;; against a TLS-only port and hangs until the timeout. EMAIL_USE_TLS
         ;; has no secret key because starttls.enable is "use it if offered",
         ;; so the default is right even for a relay that has none. Leave an
         ;; optional key out of the secret rather than setting it empty --
         ;; #or takes the first non-nil value, and "" is not nil.
         :notification {:host    #env EMAIL_HOST
                        :port    #long #or [#env EMAIL_PORT 587]
                        :user    #env EMAIL_HOST_USER
                        :pass    #env EMAIL_HOST_PASSWORD
                        :tls     #boolean #or [#env EMAIL_USE_TLS true]
                        :ssl     #boolean #or [#env EMAIL_USE_SSL false]
                        :timeout #long #or [#env EMAIL_TIMEOUT 10000]}
         ;; The relay has to be permitted to send as this address, and relays
         ;; commonly reject a From that does not match the authenticated
         ;; account, so this usually has to track EMAIL_HOST_USER.
         :notification-from #or [#env EMAIL_FROM "noreply@akvo.org"]
         :notification-reply-to "reports@akvoflow.org"
          :sentry {:dsn #env SENTRY_DSN
                   :env #env ENV_NAME
                   :host #env POD_NAME
                   :version #env APP_VERSION}
         :max-data-report-rows nil
         :nrepl-bind            "0.0.0.0"
         }
kind: ConfigMap
metadata:
  name: akvo-flow-services
  namespace: default
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: akvo-flow-services
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      run: akvo-flow-services
  template:
    metadata:
      labels:
        run: akvo-flow-services
        akvo-flow-services-version: $TRAVIS_COMMIT
        app: akvo-flow-services
        environment: ${ENVIRONMENT}
    spec:
      volumes:
        - name: config-volume
          configMap:
            name: akvo-flow-services
        - name: git-keys-volume
          secret:
             secretName: akvo-flow-services
             defaultMode: 0700
        - name: akvo-flow-services-reports
          persistentVolumeClaim:
             claimName: akvo-flow-services-reports
      containers:
      - name: akvo-flow-services-proxy
        image: eu.gcr.io/akvo-lumen/akvo-flow-services-proxy:$TRAVIS_COMMIT
        ports:
        - containerPort: 8082
        env:
        - name: OIDC_DISCOVERY_URL
          valueFrom:
            configMapKeyRef:
              name: flow-api
              key: oidc.discovery.url
        - name: OIDC_EXPECTED_ISSUER
          valueFrom:
            configMapKeyRef:
              name: flow-api
              key: oidc.expected.issuer
      - name: akvo-flow-services
        image: eu.gcr.io/akvo-lumen/akvo-flow-services:$TRAVIS_COMMIT
        ports:
        - containerPort: 3000
        resources:
          requests:
            cpu: ${POD_CPU_REQUESTS}
            memory: ${POD_MEM_REQUESTS}
          limits:
            cpu: ${POD_CPU_LIMITS}
            memory: ${POD_MEM_LIMITS}
        env:
         - name: POD_NAME
           valueFrom:
             fieldRef:
               fieldPath: metadata.name
         - name: POD_NAMESPACE
           valueFrom:
             fieldRef:
               fieldPath: metadata.namespace
         - name: APP_VERSION
           value: $TRAVIS_COMMIT
         - name: ENV_NAME
           valueFrom:
             configMapKeyRef:
               name: akvo
               key: environment
         - name: SENTRY_DSN
           valueFrom:
             secretKeyRef:
               name: akvo-flow-services
               key: sentry-dsn
         # The optional keys have defaults in the ConfigMap above, so the pod
         # still starts before they are populated. EMAIL_HOST has none.
         - name: EMAIL_HOST
           valueFrom:
             secretKeyRef:
               name: mailjet
               key: email-host
         - name: EMAIL_HOST_USER
           valueFrom:
             secretKeyRef:
               name: mailjet
               key: email-user
         - name: EMAIL_HOST_PASSWORD
           valueFrom:
             secretKeyRef:
               name: mailjet
               key: email-password
         - name: EMAIL_FROM
           valueFrom:
             secretKeyRef:
               name: mailjet
               key: email-from
               optional: true
         - name: EMAIL_PORT
           valueFrom:
             secretKeyRef:
               name: mailjet
               key: email-port
               optional: true
         - name: EMAIL_USE_SSL
           valueFrom:
             secretKeyRef:
               name: mailjet
               key: email-use-ssl
               optional: true
        volumeMounts:
          - name: config-volume
            mountPath: /etc/config/akvo-flow-services
            readOnly: true
          - name: git-keys-volume
            mountPath: /root/.ssh
            readOnly: true
          - name: akvo-flow-services-reports
            mountPath: /var/tmp/akvo/flow
        livenessProbe:
          httpGet:
            path: /healthz
            port: 3000
          initialDelaySeconds: 90
        readinessProbe:
          httpGet:
            path: /healthz
            port: 3000
          initialDelaySeconds: 90

---
apiVersion: v1
kind: Service
metadata:
  name: akvo-flow-services
  namespace: default
  labels:
    run: akvo-flow-services
spec:
  type: NodePort
  ports:
  - port: 8082
    targetPort: 8082
  selector:
    run: akvo-flow-services
---
kind: PersistentVolumeClaim
apiVersion: v1
metadata:
  name: akvo-flow-services-reports
  labels:
    app: akvo-flow-services
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: ${REPORTS_STORAGE}
